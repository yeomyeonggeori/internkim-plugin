#!/usr/bin/env python3
from __future__ import annotations

import os
import pathlib
import sys

from core.office_commands import COMMANDS, FORMATS, Command, find_command, find_format
from office_guide import formats_text, guide_text, guide_verbs
from core.office_result import DEPENDENCIES_UNAVAILABLE, UNKNOWN_COMMAND, OfficeFailure, failure_result, print_result, run_command
from core.office_schema import closest_name
from core.office_setup import SETUP_SUMMARY, setup_result
from skill_runtime import ensure_requirements, environment_path


SCRIPTS_PATH = pathlib.Path(__file__).resolve().parent
PYTHON_COMMAND_SUMMARY = "run a task-local Python script with the office packages"
GUIDE_COMMAND_SUMMARY = "print a format's commands, input fields and issue codes"
MODULE_LAUNCHER = "import runpy, sys; sys.path[0] = sys.argv.pop(1); runpy.run_module(sys.argv.pop(1), run_name='__main__', alter_sys=True)"


def main(arguments: list[str]) -> int:
    if not arguments or arguments[0] in {"-h", "--help", "help"}:
        print(usage())
        return 0
    if arguments[0] == "guide":
        return print_guide(arguments[1:])
    if arguments[0] == "python":
        return run_python(arguments[1:])
    if arguments[0] == "setup":
        return run_command(lambda: setup_result(arguments[1:]))
    command = find_command(arguments)
    if command is None:
        return run_command(lambda: reject_unknown_command(arguments[:2]))
    return run_office_command(command, arguments[len(command.words):])


def usage() -> str:
    width = max(len(command.name) for command in COMMANDS)
    lines = [
        "usage: office <format> <verb> [arguments]",
        "       office convert <input> <output>",
        "       office guide <format> [verb [operation]]",
        "       office python <script.py> [arguments]",
        "       office setup [--with-ocr]",
        "",
    ]
    lines.extend(f"  {command.name.ljust(width)}  {command.summary}" for command in COMMANDS)
    lines.append(f"  {'guide'.ljust(width)}  {GUIDE_COMMAND_SUMMARY}")
    lines.append(f"  {'python'.ljust(width)}  {PYTHON_COMMAND_SUMMARY}")
    lines.append(f"  {'setup'.ljust(width)}  {SETUP_SUMMARY}")
    lines.extend(["", "Each command's own --help lists its arguments."])
    return "\n".join(lines)


def print_guide(arguments: list[str]) -> int:
    if not arguments or arguments[0] in {"-h", "--help", "help"}:
        print(formats_text())
        return 0
    return run_text_command(lambda: guide_for(arguments))


def guide_for(arguments: list[str]) -> str:
    office_format = find_format(arguments[0])
    if office_format is None:
        reject_unknown_topic(arguments[0], [office_format.name for office_format in FORMATS], "office guide")
    verb = arguments[1] if len(arguments) > 1 else None
    if verb is not None and verb not in guide_verbs(office_format):
        reject_unknown_topic(verb, guide_verbs(office_format), f"office guide {office_format.name}")
    operation = arguments[2] if len(arguments) > 2 else None
    return guide_text(office_format, verb, operation)


def reject_unknown_topic(written: str, names: list[str], prefix: str):
    match = closest_name(written, names)
    suggestion = f"{prefix} {match}" if match else f"one of: {', '.join(names)}"
    raise OfficeFailure(UNKNOWN_COMMAND.issue(f"{prefix}: no topic {written!r}", written, suggestion))


def run_text_command(command) -> int:
    try:
        text = command()
    except OfficeFailure as failure:
        return print_result(failure_result(failure.issues))
    print(text)
    return 0


def reject_unknown_command(words: list[str]):
    raise OfficeFailure(UNKNOWN_COMMAND.issue(f"office: unknown command {' '.join(words)!r}", " ".join(words), suggestion=unknown_command_suggestion(words)))


def unknown_command_suggestion(words: list[str]) -> str | None:
    format_name = words[0] if find_format(words[0]) else closest_name(words[0], [office_format.name for office_format in FORMATS])
    if format_name is None:
        return None
    meant = closest_command(format_name, words[1:2])
    if meant is not None:
        return f"did you mean office {meant.name}? rerun with that command"
    return format_commands_suggestion(format_name)


def closest_command(format_name: str, verb_words: list[str]) -> Command | None:
    commands = [command for command in COMMANDS if command.format_name == format_name]
    if len(commands) == 1 and not commands[0].verb:
        return commands[0]
    if not verb_words:
        return None
    verb = verb_words[0] if any(command.verb == verb_words[0] for command in commands) else closest_name(verb_words[0], [command.verb for command in commands])
    return next((command for command in commands if command.verb == verb), None)


def format_commands_suggestion(format_name: str) -> str | None:
    commands = [command.name for command in COMMANDS if command.format_name == format_name]
    return f"run one of {', '.join(commands)}" if commands else None


def reject_unprepared_environment():
    raise OfficeFailure(DEPENDENCIES_UNAVAILABLE.issue(f"the office Python environment at {environment_path(SCRIPTS_PATH)} is not prepared", str(environment_path(SCRIPTS_PATH))))


def run_python(arguments: list[str]) -> int:
    if not arguments:
        print("usage: office python <script.py> [arguments]", file=sys.stderr)
        return 2
    if not ensure_requirements(SCRIPTS_PATH):
        return run_command(reject_unprepared_environment)
    os.execve(sys.executable, [sys.executable, *arguments], script_environment(None))


def run_office_command(command: Command, arguments: list[str]) -> int:
    if command.needs_packages and not ensure_requirements(SCRIPTS_PATH):
        return run_command(reject_unprepared_environment)
    os.execve(sys.executable, [sys.executable, "-c", MODULE_LAUNCHER, str(SCRIPTS_PATH), command.module, *arguments], script_environment(command))


def script_environment(command: Command | None) -> dict[str, str]:
    environment = os.environ.copy()
    python_paths = [str(SCRIPTS_PATH), environment.get("PYTHONPATH", "")]
    environment["PYTHONPATH"] = os.pathsep.join(path for path in python_paths if path)
    if command is not None:
        environment["OFFICE_COMMAND"] = f"office {command.name}"
    return environment


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
