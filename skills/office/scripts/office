#!/usr/bin/env python3
from __future__ import annotations

import os
import pathlib
import sys

from office_commands import COMMANDS, FORMATS, Command, find_command, find_format
from office_guide import formats_text, guide_text, guide_verbs
from office_result import DEPENDENCIES_UNAVAILABLE, UNKNOWN_COMMAND, OfficeFailure, failure_result, print_result, run_command
from office_schema import closest_name
from skill_runtime import ensure_requirements


SKILL_NAME = "office"
SCRIPTS_PATH = pathlib.Path(__file__).resolve().parent
PYTHON_COMMAND_SUMMARY = "run a task-local Python script with the office packages installed"
GUIDE_COMMAND_SUMMARY = "print a format's commands, input fields and issue codes"


def main(arguments: list[str]) -> int:
    if not arguments or arguments[0] in {"-h", "--help", "help"}:
        print(usage())
        return 0
    if arguments[0] == "guide":
        return print_guide(arguments[1:])
    if arguments[0] == "python":
        return run_python(arguments[1:])
    command = find_command(arguments)
    if command is None:
        return run_command(lambda: reject_unknown_command(arguments[:2]))
    return run_office_command(command, arguments[len(command.words):])


def usage() -> str:
    width = max(len(command.name) for command in COMMANDS)
    lines = [
        "usage: office <format> <verb> [arguments]",
        "       office convert <input> <output>",
        "       office guide <format> [verb [operation]]",
        "       office python <script.py> [arguments]",
        "",
    ]
    lines.extend(f"  {command.name.ljust(width)}  {command.summary}" for command in COMMANDS)
    lines.append(f"  {'guide'.ljust(width)}  {GUIDE_COMMAND_SUMMARY}")
    lines.append(f"  {'python'.ljust(width)}  {PYTHON_COMMAND_SUMMARY}")
    lines.extend(["", "Each command's own --help lists its arguments."])
    return "\n".join(lines)


def print_guide(arguments: list[str]) -> int:
    if not arguments or arguments[0] in {"-h", "--help", "help"}:
        print(formats_text())
        return 0
    return run_text_command(lambda: guide_for(arguments))


def guide_for(arguments: list[str]) -> str:
    office_format = find_format(arguments[0])
    if office_format is None:
        reject_unknown_topic(arguments[0], [office_format.name for office_format in FORMATS], "office guide")
    verb = arguments[1] if len(arguments) > 1 else None
    if verb is not None and verb not in guide_verbs(office_format):
        reject_unknown_topic(verb, guide_verbs(office_format), f"office guide {office_format.name}")
    operation = arguments[2] if len(arguments) > 2 else None
    return guide_text(office_format, verb, operation)


def reject_unknown_topic(written: str, names: list[str], prefix: str):
    match = closest_name(written, names)
    suggestion = f"{prefix} {match}" if match else f"one of: {', '.join(names)}"
    raise OfficeFailure(UNKNOWN_COMMAND.issue(f"{prefix}: no topic {written!r}", written, suggestion))


def run_text_command(command) -> int:
    try:
        text = command()
    except OfficeFailure as failure:
        return print_result(failure_result(failure.issues))
    print(text)
    return 0


def reject_unknown_command(words: list[str]):
    raise OfficeFailure(UNKNOWN_COMMAND.issue(f"office: unknown command {' '.join(words)!r}", " ".join(words)))


def reject_missing_dependencies():
    raise OfficeFailure(DEPENDENCIES_UNAVAILABLE.issue("office dependencies could not be installed"))


def run_python(arguments: list[str]) -> int:
    if not arguments:
        print("usage: office python <script.py> [arguments]", file=sys.stderr)
        return 2
    if not ensure_requirements(SKILL_NAME):
        return 1
    os.execve(sys.executable, [sys.executable, *arguments], script_environment(None))


def run_office_command(command: Command, arguments: list[str]) -> int:
    if command.needs_packages and not ensure_requirements(SKILL_NAME):
        return run_command(reject_missing_dependencies)
    script_path = str(SCRIPTS_PATH / command.script)
    if script_path.endswith(".sh"):
        os.execvpe("bash", ["bash", script_path, *arguments], script_environment(command))
    os.execve(sys.executable, [sys.executable, script_path, *arguments], script_environment(command))


def script_environment(command: Command | None) -> dict[str, str]:
    environment = os.environ.copy()
    python_paths = [str(SCRIPTS_PATH), environment.get("PYTHONPATH", "")]
    environment["PYTHONPATH"] = os.pathsep.join(path for path in python_paths if path)
    if command is not None:
        environment["OFFICE_COMMAND"] = f"office {command.name}"
    return environment


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
