{
  "name": "intl/letter",
  "kind": "document",
  "language": "ko",
  "summary": "a letter or notice from the company on its letterhead, as a Korean 공문 or an international letter by its language; the runtime writes the letterhead, date, signer and seal",
  "guidance": "Choose the sections and block kinds the request's content needs. Every item, row and field comes from the request or its attachments; a section, item or paragraph the request gives no content for is left out, never filled in. A letter may open or close with a short courtesy line, such as a greeting, thanks or good wishes, that states no date, number, name, promise, condition or cause.",
  "fields": [
    {
      "name": "language",
      "type": "text",
      "choices": [
        "ko",
        "en"
      ],
      "optional": true
    },
    {
      "name": "recipient",
      "label": "수신",
      "type": "text"
    },
    {
      "name": "reference",
      "label": "참조",
      "type": "text",
      "optional": true,
      "description": "who else the letter is addressed to, as the request names them"
    },
    {
      "name": "title",
      "type": "text"
    },
    {
      "name": "salutation",
      "type": "text",
      "optional": true,
      "description": "an English letter's greeting line, such as Dear Ms. Park, with the name as the request gives it"
    },
    {
      "name": "sections",
      "label": "sections",
      "type": "list",
      "fields": [
        {
          "name": "heading",
          "type": "text"
        },
        {
          "name": "blocks",
          "label": "blocks",
          "type": "list",
          "fields": [
            {
              "name": "type",
              "label": "block kind",
              "type": "text",
              "choices": [
                "paragraph",
                "items",
                "table",
                "fields",
                "chart"
              ],
              "description": "paragraph: text; items: items; table: columns and rows; fields: label and value pairs; chart: chart, labels, series"
            },
            {
              "name": "text",
              "type": "text",
              "optional": true,
              "description": "paragraph: prose that restates or connects what the request says; no fact the request does not state"
            },
            {
              "name": "items",
              "type": "list",
              "optional": true,
              "description": "items: one entry per item the request names, no others",
              "fields": [
                {
                  "name": "text",
                  "type": "text",
                  "description": "the item in the request's words, without the date, owner, due date, amount or status, which have their own fields"
                },
                {
                  "name": "date",
                  "type": "date",
                  "optional": true,
                  "description": "when it happened or happens"
                },
                {
                  "name": "owner",
                  "type": "person",
                  "optional": true,
                  "description": "who is responsible; null when the request says it is not decided yet or does not name one an item needs; leave it out when no owner applies"
                },
                {
                  "name": "due",
                  "type": "date",
                  "optional": true,
                  "description": "due date; null when the item needs one the request does not give; leave it out when none applies"
                },
                {
                  "name": "quantity",
                  "type": "quantity",
                  "optional": true
                },
                {
                  "name": "unit",
                  "type": "text",
                  "optional": true
                },
                {
                  "name": "amount",
                  "type": "amount",
                  "optional": true
                },
                {
                  "name": "currency",
                  "type": "text",
                  "optional": true,
                  "description": "KRW, USD and so on"
                },
                {
                  "name": "percent",
                  "type": "percent",
                  "optional": true
                },
                {
                  "name": "status",
                  "type": "text",
                  "optional": true
                }
              ]
            },
            {
              "name": "numbered",
              "type": "boolean",
              "optional": true
            },
            {
              "name": "columns",
              "type": "list",
              "optional": true,
              "fields": [
                {
                  "name": "name",
                  "type": "text"
                },
                {
                  "name": "type",
                  "type": "text",
                  "choices": [
                    "text",
                    "person",
                    "organization",
                    "date",
                    "amount",
                    "quantity",
                    "percent"
                  ]
                },
                {
                  "name": "unit",
                  "type": "text",
                  "optional": true,
                  "description": "currency code for amount, counted unit for quantity"
                }
              ]
            },
            {
              "name": "rows",
              "type": "list",
              "item": "row",
              "optional": true,
              "description": "table: one list of cells per row, numbers as numbers, dates as YYYY-MM-DD, null for a value not given"
            },
            {
              "name": "totals",
              "type": "boolean",
              "optional": true,
              "description": "table: add a total row that sums the amount and quantity columns"
            },
            {
              "name": "fields",
              "type": "list",
              "optional": true,
              "fields": [
                {
                  "name": "label",
                  "type": "text"
                },
                {
                  "name": "type",
                  "type": "text",
                  "choices": [
                    "text",
                    "person",
                    "organization",
                    "date",
                    "amount",
                    "quantity",
                    "percent"
                  ]
                },
                {
                  "name": "value",
                  "type": "cell",
                  "description": "null when the request does not give it"
                },
                {
                  "name": "unit",
                  "type": "text",
                  "optional": true
                }
              ]
            },
            {
              "name": "chart",
              "type": "text",
              "optional": true,
              "choices": [
                "column",
                "bar",
                "line",
                "pie"
              ]
            },
            {
              "name": "labels",
              "type": "list",
              "item": "text",
              "optional": true
            },
            {
              "name": "series",
              "type": "list",
              "optional": true,
              "fields": [
                {
                  "name": "name",
                  "type": "text"
                },
                {
                  "name": "values",
                  "type": "list",
                  "item": "amount"
                }
              ]
            },
            {
              "name": "caption",
              "type": "text",
              "optional": true
            }
          ]
        }
      ]
    },
    {
      "name": "enclosures",
      "label": "붙임",
      "type": "list",
      "item": "text",
      "optional": true,
      "description": "the name of each document the letter encloses, as the request names it"
    }
  ],
  "known": {
    "company": "company",
    "date": "today"
  },
  "layout": {
    "parts": [
      {
        "type": "letterhead"
      },
      {
        "type": "labeled",
        "for": "ko",
        "rows": [
          {
            "label": "수신",
            "value": "{recipient}"
          },
          {
            "label": "참조",
            "value": "{reference}"
          },
          {
            "label": "제목",
            "value": "{title}"
          }
        ]
      },
      {
        "type": "lines",
        "for": "en",
        "lines": [
          "{date}",
          "",
          "{recipient}",
          "",
          "**{title}**",
          "",
          "{salutation}"
        ]
      },
      {
        "type": "sections",
        "field": "sections"
      },
      {
        "type": "enclosures",
        "field": "enclosures",
        "label": {
          "ko": "붙임",
          "en": "Enclosures"
        }
      },
      {
        "type": "lines",
        "for": "ko",
        "lines": [
          "끝."
        ]
      },
      {
        "type": "signature",
        "for": "ko",
        "lines": [
          "{date}",
          "{company.name}",
          "{company.representativeTitle} {company.representative}"
        ],
        "sealMark": "(인)",
        "stamp": true
      },
      {
        "type": "lines",
        "for": "en",
        "lines": [
          "Sincerely,"
        ]
      },
      {
        "type": "signature",
        "for": "en",
        "align": "left",
        "lines": [
          "{company.representative}",
          "{company.representativeTitle}, {company.name}"
        ]
      }
    ]
  }
}
