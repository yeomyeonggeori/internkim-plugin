{
  "title": "표 준 근 로 계 약 서",
  "articleHeading": "{number}. {heading}",
  "terms": [
    {"name": "companyName", "type": "text", "meaning": "employer's trade name"},
    {"name": "companyPhone", "type": "text", "meaning": "employer's phone", "optional": true},
    {"name": "companyAddress", "type": "text", "meaning": "employer's address", "optional": true},
    {"name": "representative", "type": "text", "meaning": "employer's representative"},
    {"name": "employeeName", "type": "text", "meaning": "employee's name"},
    {"name": "employeeAddress", "type": "text", "meaning": "employee's address", "optional": true},
    {"name": "employeePhone", "type": "text", "meaning": "employee's phone", "optional": true},
    {"name": "startDate", "type": "text", "meaning": "first working day"},
    {"name": "endDate", "type": "text", "meaning": "last day of a fixed-term contract; blank for an open-ended one leaves the contract-period line out"},
    {"name": "workplace", "type": "text", "meaning": "place of work"},
    {"name": "duties", "type": "text", "meaning": "the work to be done"},
    {"name": "workStartTime", "type": "text", "meaning": "daily start time"},
    {"name": "workEndTime", "type": "text", "meaning": "daily end time"},
    {"name": "breakStart", "type": "text", "meaning": "break start time"},
    {"name": "breakEnd", "type": "text", "meaning": "break end time"},
    {"name": "workDays", "type": "text", "meaning": "working days of the week, such as 월~금"},
    {"name": "weeklyHoliday", "type": "text", "meaning": "weekly paid holiday, such as 일요일"},
    {"name": "monthlySalary", "type": "text", "meaning": "monthly wage"},
    {"name": "bonus", "type": "text", "meaning": "bonus, or 없음"},
    {"name": "otherAllowances", "type": "text", "meaning": "other allowances, or 없음"},
    {"name": "payday", "type": "text", "meaning": "pay day, such as 매월 25일"},
    {"name": "paymentMethod", "type": "text", "meaning": "how wages are paid"},
    {"name": "insurances", "type": "text", "meaning": "which social insurances apply, each checked ☑ or unchecked ☐"},
    {"name": "contractDate", "type": "text", "meaning": "signing date, YYYY년 M월 D일"}
  ],
  "preamble": [
    "{{ companyName }}(이하 \"사업주\"라 함)과(와) {{ employeeName }}(이하 \"근로자\"라 함)은 다음과 같이 근로계약을 체결한다."
  ],
  "articles": [
    {"key": "start", "heading": "근로개시일", "paragraphs": [
      "근로개시일: {{ startDate }}",
      {"text": "근로계약기간: {{ startDate }}부터 {{ endDate }}까지", "when": "endDate"}
    ]},
    {"key": "workplace", "heading": "근무장소", "paragraphs": ["{{ workplace }}"]},
    {"key": "duties", "heading": "업무의 내용", "paragraphs": ["{{ duties }}"]},
    {"key": "hours", "heading": "소정근로시간", "paragraphs": [
      "{{ workStartTime }}부터 {{ workEndTime }}까지 (휴게시간: {{ breakStart }} ~ {{ breakEnd }})"
    ]},
    {"key": "workDays", "heading": "근무일 및 휴일", "paragraphs": [
      "매주 {{ workDays }} 근무, 주휴일 매주 {{ weeklyHoliday }}"
    ]},
    {"key": "wages", "heading": "임금", "paragraphs": [
      "- 월급: {{ monthlySalary }}",
      "- 상여금: {{ bonus }}",
      "- 기타급여(제수당 등): {{ otherAllowances }}",
      "- 임금지급일: {{ payday }} (휴일의 경우는 전일 지급)",
      "- 지급방법: {{ paymentMethod }}"
    ]},
    {"key": "annualLeave", "heading": "연차유급휴가", "paragraphs": [
      "연차유급휴가는 근로기준법에서 정하는 바에 따라 부여함"
    ]},
    {"key": "insurance", "heading": "사회보험 적용여부", "paragraphs": ["{{ insurances }}"]},
    {"key": "delivery", "heading": "근로계약서 교부", "paragraphs": [
      "사업주는 근로계약을 체결함과 동시에 본 계약서를 사본하여 근로자의 교부요구와 관계없이 근로자에게 교부함 (근로기준법 제17조 이행)"
    ]},
    {"key": "faithfulPerformance", "heading": "근로계약, 취업규칙 등의 성실한 이행의무", "paragraphs": [
      "사업주와 근로자는 각자가 근로계약, 취업규칙, 단체협약을 지키고 성실하게 이행하여야 함"
    ]},
    {"key": "other", "heading": "기타", "paragraphs": [
      "이 계약에 정함이 없는 사항은 근로기준법령에 의함"
    ]}
  ],
  "closing": [
    "",
    {"centered": "{{ contractDate }}"},
    ""
  ],
  "signatures": [
    ["(사업주)", "사업체명: {{ companyName }} (전화: {{ companyPhone }})", "주소: {{ companyAddress }}", "대표자: {{ representative }} (서명)"],
    ["(근로자)", "주소: {{ employeeAddress }}", "연락처: {{ employeePhone }}", "성명: {{ employeeName }} (서명)"]
  ]
}
