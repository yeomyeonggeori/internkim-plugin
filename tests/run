#!/usr/bin/env python3
import concurrent.futures
import os
import subprocess
import sys
import time
from pathlib import Path

TESTS = Path(__file__).resolve().parent
OFFICE_SCRIPTS = TESTS.parent / "skills" / "office" / "scripts"
OFFICE_PYTHON = OFFICE_SCRIPTS / ".venv" / "bin" / "python"


def prepare_the_office_environment():
    setup = subprocess.run([sys.executable, str(OFFICE_SCRIPTS / "office"), "setup"], capture_output=True, text=True)
    if setup.returncode != 0:
        raise SystemExit(f"office setup failed, so the suite would run without what it tests:\n{setup.stdout}{setup.stderr}")


def run_test_file(test_file):
    started = time.monotonic()
    completed = subprocess.run(
        [str(OFFICE_PYTHON), "-m", "unittest", "discover", "-s", str(TESTS), "-p", test_file.name],
        cwd=TESTS.parent,
        capture_output=True,
        text=True,
    )
    return test_file.name, completed.returncode, time.monotonic() - started, completed.stderr


def selected_test_files(names):
    if not names:
        return sorted(TESTS.glob("test_*.py"))
    return [TESTS / (name if name.endswith(".py") else f"{name}.py") for name in names]


def main(names):
    prepare_the_office_environment()
    test_files = selected_test_files(names)
    failed = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=os.cpu_count()) as pool:
        for name, returncode, seconds, output in pool.map(run_test_file, test_files):
            print(f"{'ok  ' if returncode == 0 else 'FAIL'} {name} ({seconds:.0f}s)", flush=True)
            if returncode != 0:
                failed.append((name, output))
    for name, output in failed:
        print(f"\n=== {name} ===\n{output}")
    print(f"\n{len(test_files) - len(failed)} of {len(test_files)} test files passed")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
