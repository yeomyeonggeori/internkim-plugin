{
  "name": "internkim",
  "version": "0.4.0",
  "description": "Every skill from the InternKim agent, packaged to run on any Agent Plugins client, with InternKim's tool server declared for the workspace skills: office documents, calculation, weather, data room, tasks, calendar, messages, mail and sites.",
  "license": "Apache-2.0",
  "repository": "https://github.com/yeomyeonggeori/internkim-plugin",
  "keywords": [
    "xlsx",
    "pptx",
    "pdf",
    "korean",
    "office",
    "weather",
    "tasks",
    "calendar",
    "mcp"
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test tests/pi",
    "check": "tsc --noEmit",
    "check:manifests": "python3 scripts/generate_client_manifests.py --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./adapters/pi/index.ts"
    ]
  }
}
